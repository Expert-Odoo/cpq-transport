<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cpq_transport_product_form" model="ir.ui.view">
        <field name="name">cpq.transport.product.form</field>
        <field name="model">cpq.transport.product</field>
        <field name="arch" type="xml">
            <form string="Transport service">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Local delivery Île-de-France"/></h1>
                    </div>
                    <group>
                        <field name="product_tmpl_id"
                               options="{'no_create_edit': False}"
                               context="{'default_type': 'service', 'default_list_price': 0.0}"/>
                        <field name="active" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <notebook>
                        <!-- ── Configuration ─────────────────────────────────────────── -->
                        <page string="Configuration" name="configuration">
                            <group>
                                <group string="Pricing">
                                    <field name="default_price_per_km"/>
                                </group>
                                <group string="Origin">
                                    <field name="origin_default" placeholder="e.g. 10 rue de Paris, 75001 Paris"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-2" role="alert" style="font-size:13px;">
                                <strong>How it works:</strong>
                                When a salesperson adds this product to a quotation, the transport
                                configurator opens with the <strong>Default price / km</strong> and
                                <strong>Default origin</strong> pre-filled. The salesperson only needs to
                                enter the destination address — Google Routes API computes the distance
                                and the line price is updated automatically.
                            </div>
                        </page>

                        <!-- ── Paid Add-ons ──────────────────────────────────────────── -->
                        <page string="Paid Add-ons" name="addons_upsell">
                            <div class="alert alert-warning" role="alert" style="font-size:13px;">
                                <strong>Coming soon on the Odoo App Store:</strong>
                                <ul class="mt-2 mb-0">
                                    <li><strong>CPQ Transport — Advanced Rules</strong> —
                                        Distance-based tiered pricing, weekend/holiday surcharges,
                                        free-km allowance, per-zone rates.</li>
                                </ul>
                            </div>
                            <div class="alert alert-info mt-2" role="alert" style="font-size:13px;">
                                Follow <a href="https://expodo.fr" target="_blank">expodo.fr</a>
                                and the Odoo App Store to be notified when the add-on is released.
                            </div>
                        </page>

                        <!-- ── Notes ────────────────────────────────────────────────── -->
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes about this transport service..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cpq_transport_product_list" model="ir.ui.view">
        <field name="name">cpq.transport.product.list</field>
        <field name="model">cpq.transport.product</field>
        <field name="arch" type="xml">
            <list string="Transport services">
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="default_price_per_km"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="origin_default"/>
            </list>
        </field>
    </record>

    <record id="view_cpq_transport_product_kanban" model="ir.ui.view">
        <field name="name">cpq.transport.product.kanban</field>
        <field name="model">cpq.transport.product</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="default_price_per_km"/>
                <field name="currency_id"/>
                <field name="origin_default"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details p-2">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle text-muted">
                                <field name="product_tmpl_id"/>
                            </div>
                            <div class="mt-2">
                                <span t-if="record.default_price_per_km.raw_value">
                                    <field name="default_price_per_km" widget="monetary"/> / km
                                </span>
                            </div>
                            <div t-if="record.origin_default.raw_value" class="text-muted small">
                                📍 <field name="origin_default"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
