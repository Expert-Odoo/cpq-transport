<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bouton "Configure transport" sur la ligne + smart button sur l'entête -->
    <record id="view_order_form_transport" model="ir.ui.view">
        <field name="name">sale.order.form.transport</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_configure_transport_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="transport_line_count == 0">
                    <field name="transport_line_count" widget="statinfo" string="Transport"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="is_transport" column_invisible="1"/>
                <field name="transport_config_id" column_invisible="1"/>
                <field name="transport_summary" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Sélecteur multi-lignes -->
    <record id="view_cpq_transport_line_selector_form" model="ir.ui.view">
        <field name="name">cpq.transport.line.selector.form</field>
        <field name="model">cpq.transport.line.selector</field>
        <field name="arch" type="xml">
            <form string="Choose a transport line">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="line_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="line_summary" readonly="1"/>
                </group>
                <footer>
                    <button name="action_open_configurator"
                            type="object"
                            string="Configure"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
