<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cpq_transport_wizard_form" model="ir.ui.view">
        <field name="name">cpq.transport.wizard.form</field>
        <field name="model">cpq.transport.wizard</field>
        <field name="arch" type="xml">
            <form string="Configure transport">
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="last_signature" invisible="1"/>
                <field name="last_computed_at" invisible="1"/>
                <div class="alert alert-warning"
                     role="alert"
                     invisible="not warning_msg">
                    <field name="warning_msg" readonly="1" nolabel="1"/>
                </div>
                <group col="1">
                    <field name="origin_address" widget="transport_places_v2" required="1"/>
                    <field name="destination_address" widget="transport_places_v2" required="1"/>
                    <field name="trip_type"/>
                    <field name="price_per_km" required="1"/>
                    <field name="distance_km" readonly="1"/>
                    <field name="computed_price" readonly="1"/>
                </group>
                <footer>
                    <button name="action_compute_distance"
                            type="object"
                            string="📍 Compute distance"
                            class="btn-primary"
                            invisible="state == 'computed'"/>
                    <button name="action_compute_distance"
                            type="object"
                            string="📍 Recompute distance"
                            class="btn-secondary"
                            invisible="state != 'stale' and state != 'computed'"/>
                    <button name="action_validate"
                            type="object"
                            string="Validate"
                            class="btn-primary"
                            invisible="state != 'computed'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
